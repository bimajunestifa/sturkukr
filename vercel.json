{
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(.*WhatsApp.*|.*facebookexternalhit.*|.*Facebot.*|.*Twitterbot.*|.*TelegramBot.*|.*Slackbot.*|.*LinkedInBot.*|.*Discordbot.*)"
        }
      ],
      "destination": "/api/og-preview"
    }
  ]
}
